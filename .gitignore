# global ignore
**/.env
**/data/
**/secrets/
**/backups/

# passwords
*.htpasswd

# Shared
shared/renew-all-certs.log

# Proxy
proxy/letsencrypt/
proxy/letsencrypt-logs/
proxy/webroot/
proxy/nginx/snippets/auth

# Postgres
apps/postgres/data
apps/postgres/secrets
apps/postgres/pgadmin-data

# MarinAPP
apps/marinapp/src
apps/marinapp/**/config.json
apps/marinapp/**/config.js
apps/marinapp/web.config.json
apps/marinapp/web.config.js
apps/marinapp/api.config.json

# Knecta
apps/knecta/repo

# Boringproxy
apps/boringproxy/src

# NextCloud

# Backups / dumps (never commit)
*.sql
*.zip
*.tar.gz
apps/postgres/data-pg16-backup

/.claude

# Nginx logs (written to host for CrowdSec)
proxy/nginx/logs/

# Mattermost
apps/mattermost/config/
apps/mattermost/logs/

# Guacamole
apps/guacamole/guacamole-home/
