# global ignore
**/.env
**/data/
**/secrets/
**/backups/

# passwords
*.htpasswd

# Shared
shared/renew-all-certs.log
shared/backup-postgres-to-s3.env
shared/backup-logs/
shared/cert-health-logs/
shared/*.bak.*
apps/postgres/backups/

# Proxy
proxy/letsencrypt/
proxy/letsencrypt-logs/
proxy/webroot/
proxy/nginx/snippets/auth

# Postgres
apps/postgres/data
apps/postgres/secrets
apps/postgres/pgadmin-data

# MarinAPP
apps/marinapp/src
apps/marinapp/**/config.json
apps/marinapp/**/config.js
apps/marinapp/web.config.json
apps/marinapp/web.config.js
apps/marinapp/api.config.json

# Knecta
apps/knecta/repo

# Neo4j (runtime data; .env, data/, backups/ already covered by global rules)
apps/neo4j/logs
apps/neo4j/plugins
apps/neo4j/conf
apps/neo4j/ssl

# Boringproxy
apps/boringproxy/src

# NextCloud

# Backups / dumps (never commit)
*.sql
*.zip
*.tar.gz
apps/postgres/data-pg16-backup

/.claude

# Nginx logs (written to host for CrowdSec)
proxy/nginx/logs/

# Mattermost
apps/mattermost/config/
apps/mattermost/logs/

# Guacamole
apps/guacamole/guacamole-home/

# Per-app runtime data / state (cloned repos, deploy logs, update markers — never commit)
apps/*/repo/
apps/*/logs/
apps/*/.update-state
apps/*/*-backup.log

# LibreChat runtime data + secret-bearing searxng config
apps/librechat/data-meili/
apps/librechat/data-mongo/
apps/librechat/searxng/
